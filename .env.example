# ============ AI Toy Lab — copy to .env and fill in ============
# Never commit .env. Keys are read only from the environment.

# ---- LLM ----
# LLM_PROVIDER: openai_compat | anthropic | mock
#   openai_compat works with Ollama (local, free), LM Studio, Groq, OpenRouter, OpenAI...
LLM_PROVIDER=openai_compat
LLM_API_KEY=
# Ollama (local, free):   http://localhost:11434/v1   model e.g. llama3.2:3b
# Groq (free tier):       https://api.groq.com/openai/v1   model e.g. llama-3.1-8b-instant
# OpenAI:                 https://api.openai.com/v1        model e.g. gpt-4o-mini
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
# For LLM_PROVIDER=anthropic: set LLM_API_KEY (or ANTHROPIC_API_KEY) and LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=30
LLM_HISTORY_TURNS=6

# ---- Speech-to-text ----
# STT_PROVIDER: mlx_whisper (local, Apple Silicon GPU, ~2x faster) | faster_whisper (local CPU) | openai_compat | mock
# STT_MLX_MODEL=mlx-community/whisper-large-v3-turbo
STT_PROVIDER=faster_whisper
STT_API_KEY=
# faster_whisper: tiny.en | base.en | small.en ... ; openai_compat: whisper-1 / whisper-large-v3
STT_MODEL=base.en
# faster_whisper only: used when the active personality's language isn't English (hi, te, ...)
# and STT_MODEL is English-only (*.en). The personality's language is passed as a hint.
#   large-v3-turbo ≈ 1.6 GB (default; correct Hindi + Telugu, ~6 s/turn on a Mac CPU)
#   small ≈ 480 MB (OK Hindi, but writes Telugu speech in Devanagari script)
STT_MULTILINGUAL_MODEL=large-v3-turbo
STT_BASE_URL=https://api.openai.com/v1

# ---- Text-to-speech ----
# TTS_PROVIDER: edge_tts (free neural voices, online, no key; used for cartoon voices; falls back to macos_say) | macos_say (offline) | openai_compat | mock
#   Hindi/Telugu personalities use the built-in macOS voices Lekha (hi_IN) and Geeta (te_IN).
#   If a voice is missing (`say -v '?'`), the dashboard falls back to browser speech in that language.
TTS_PROVIDER=macos_say
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_BASE_URL=https://api.openai.com/v1

# ---- Server / devices ----
# The URL the ESP32 uses to reach this laptop (use the laptop's LAN IP, not localhost)
BACKEND_URL=http://192.168.1.50:8000
PORT=8000
# Default device id for tools/device_simulator.py
DEVICE_ID=esp32-sim-01
# Optional shared secret the ESP32 must send (leave blank to disable)
DEVICE_TOKEN=
HEARTBEAT_TIMEOUT_S=30

# ---- Audio & privacy ----
MAX_RECORD_SECONDS=15
# Raw child audio is NOT stored unless you turn this on
SAVE_RAW_AUDIO=false

# ---- Subscriptions (architecture only) ----
ENFORCE_QUOTAS=false
LOG_LEVEL=INFO

# Gemini TTS (TTS_PROVIDER=gemini_tts): acted, style-directed character voices (Hindi/Telugu). Free tier key: aistudio.google.com
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
